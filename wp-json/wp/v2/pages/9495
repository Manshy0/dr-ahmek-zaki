lider-no wpr-equal-height-no e-con e-parent\" data-id=\"bf11138\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t<div class=\"elementor-element elementor-element-a3ffc52 e-con-full e-flex wpr-particle-no wpr-jarallax-no wpr-parallax-no wpr-sticky-section-no wpr-column-slider-no wpr-equal-height-no e-con e-child\" data-id=\"a3ffc52\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-c96cc9b elementor-widget__width-inherit elementor-invisible elementor-widget elementor-widget-heading\" data-id=\"c96cc9b\" data-element_type=\"widget\" data-e-type=\"widget\" data-settings=\"{&quot;_animation&quot;:&quot;fadeInUp&quot;}\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<h1 class=\"elementor-heading-title elementor-size-default\">Frequently asked questions<\/h1>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-4e70d8d elementor-widget__width-initial elementor-invisible elementor-widget elementor-widget-text-editor\" data-id=\"4e70d8d\" data-element_type=\"widget\" data-e-type=\"widget\" data-settings=\"{&quot;_animation&quot;:&quot;fadeInUp&quot;,&quot;_animation_delay&quot;:200}\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<p>Need something cleared up? Here are our most frequently asked questions.<\/p>\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-f5117b5 elementor-widget__width-initial elementor-widget elementor-widget-jkit_accordion\" data-id=\"f5117b5\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"jkit_accordion.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<div  class=\"jeg-elementor-kit jkit-accordion style-default jeg_module__2_69ff269689c06\" ><div class=\"card-wrapper \">\n                <div class=\"card-header\">\n                    <a href=\"#expand-d49999f\" class=\"card-header-button\" aria-expanded=\"false\" data-target=\"#expand-d49999f\" aria-controls=\"expand-d49999f\">\n                        <div class=\"left-icon-group\">\n                <div class=\"normal-icon\"><i aria-hidden=\"true\" class=\"jki jki-plus-light\"><\/i><\/div>\n                <div class=\"active-icon\"><i aria-hidden=\"true\" class=\"jki jki-minus-light\"><\/i><\/div>\n            <\/div><span class=\"title\">How long does rotator cuff surgery take?<\/span>\n                    <\/a>\n                <\/div>\n                <div class=\"card-expand\" id=\"expand-d49999f\" style=\"display:none\"><div class=\"card-body\"><p>Most arthroscopic rotator cuff repairs take 60-90 minutes for small to medium tears, 90-120 minutes for large or massive tears, and 120-150 minutes for complex revision cases. Total time at the surgical centre including preparation and recovery monitoring is approximately 3-4 hours before same-day discharge<\/p><\/div><\/div>\n            <\/div><div class=\"card-wrapper \">\n                <div class=\"card-header\">\n                    <a href=\"#expand-339abdc\" class=\"card-header-button\" aria-expanded=\"false\" data-target=\"#expand-339abdc\" aria-controls=\"expand-339abdc\">\n                        <div class=\"left-icon-group\">\n                <div class=\"normal-icon\"><i aria-hidden=\"true\" class=\"jki jki-plus-light\"><\/i><\/div>\n                <div class=\"active-icon\"><i aria-hidden=\"true\" class=\"jki jki-minus-light\"><\/i><\/div>\n            <\/div><span class=\"title\">What is the rotator cuff surgery success rate?<\/span>\n                    <\/a>\n                <\/div>\n                <div class=\"card-expand\" id=\"expand-339abdc\" style=\"display:none\"><div class=\"card-body\"><p>Rotator cuff surgery success rate ranges from 90-95% for small tears to 65-80% for massive tears. Non-smokers with good tissue quality consistently achieve the highest healing rates. Dr. Usama's fellowship training and arthroscopic expertise achieve outcomes at the top of published success rate ranges for all tear sizes.<\/p><\/div><\/div>\n            <\/div><div class=\"card-wrapper \">\n                <div class=\"card-header\">\n                    <a href=\"#expand-cfd3e25\" class=\"card-header-button\" aria-expanded=\"false\" data-target=\"#expand-cfd3e25\" aria-controls=\"expand-cfd3e25\">\n                        <div class=\"left-icon-group\">\n                <div class=\"normal-icon\"><i aria-hidden=\"true\" class=\"jki jki-plus-light\"><\/i><\/div>\n                <div class=\"active-icon\"><i aria-hidden=\"true\" class=\"jki jki-minus-light\"><\/i><\/div>\n            <\/div><span class=\"title\">How long is rotator cuff surgery recovery time?<\/span>\n                    <\/a>\n                <\/div>\n                <div class=\"card-expand\" id=\"expand-cfd3e25\" style=\"display:none\"><div class=\"card-body\"><p>Rotator cuff surgery recovery time: sling at 4-6 weeks, desk work at 2-6 weeks, full unrestricted activities at 6-12 months. How long rotator cuff surgery recovery takes depends on tear size, tissue quality, age, and rehabilitation compliance. Dr. Usama provides a personalised rotator cuff surgery recovery timeline at consultation.<\/p><\/div><\/div>\n            <\/div><div class=\"card-wrapper \">\n                <div class=\"card-header\">\n                    <a href=\"#expand-751ef88\" class=\"card-header-button\" aria-expanded=\"false\" data-target=\"#expand-751ef88\" aria-controls=\"expand-751ef88\">\n                        <div class=\"left-icon-group\">\n                <div class=\"normal-icon\"><i aria-hidden=\"true\" class=\"jki jki-plus-light\"><\/i><\/div>\n                <div class=\"active-icon\"><i aria-hidden=\"true\" class=\"jki jki-minus-light\"><\/i><\/div>\n            <\/div><span class=\"title\">Is rotator cuff surgery worth it?<\/span>\n                    <\/a>\n                <\/div>\n                <div class=\"card-expand\" id=\"expand-751ef88\" style=\"display:none\"><div class=\"card-body\"><p>For appropriately selected patients: yes. 85-95% achieve significant pain relief, most regain 85-100% of normal strength, 90%+ return to prior activities, and 90-95% report they would do it again. Rotator cuff surgery is worth it when you have a repairable tear, have given conservative treatment a fair trial, and your function demands a strong shoulder. Dr. Usama ensures you are the right candidate before recommending surgery.<\/p><\/div><\/div>\n            <\/div><div class=\"card-wrapper \">\n                <div class=\"card-header\">\n                    <a href=\"#expand-fdae1f4\" class=\"card-header-button\" aria-expanded=\"false\" data-target=\"#expand-fdae1f4\" aria-controls=\"expand-fdae1f4\">\n                        <div class=\"left-icon-group\">\n                <div class=\"normal-icon\"><i aria-hidden=\"true\" class=\"jki jki-plus-light\"><\/i><\/div>\n                <div class=\"active-icon\"><i aria-hidden=\"true\" class=\"jki jki-minus-light\"><\/i><\/div>\n            <\/div><span class=\"title\">What does rotator cuff surgery cost in Dubai? Is it covered by insurance?<\/span>\n                    <\/a>\n                <\/div>\n                <div class=\"card-expand\" id=\"expand-fdae1f4\" style=\"display:none\"><div class=\"card-body\"><p>Rotator cuff surgery cost in Dubai ranges from AED 30,000-60,000 for standard arthroscopic repairs. Rotator cuff surgery insurance coverage applies when medically necessary most major UAE insurers including Daman, DHA, Cigna, AXA, and Bupa cover it. Our team verifies your rotator cuff surgery insurance coverage and obtains pre-authorisation before surgery.<\/p><\/div><\/div>\n            <\/div><div class=\"card-wrapper \">\n                <div class=\"card-header\">\n                    <a href=\"#expand-2252216\" class=\"card-header-button\" aria-expanded=\"false\" data-target=\"#expand-2252216\" aria-controls=\"expand-2252216\">\n                        <div class=\"left-icon-group\">\n                <div class=\"normal-icon\"><i aria-hidden=\"true\" class=\"jki jki-plus-light\"><\/i><\/div>\n                <div class=\"active-icon\"><i aria-hidden=\"true\" class=\"jki jki-minus-light\"><\/i><\/div>\n            <\/div><span class=\"title\">When can I drive after rotator cuff surgery?<\/span>\n                    <\/a>\n                <\/div>\n                <div class=\"card-expand\" id=\"expand-2252216\" style=\"display:none\"><div class=\"card-body\"><p>Driving after rotator cuff surgery is possible at 2-4 weeks for left shoulder (automatic car), 4-6 weeks for right shoulder. You must be off narcotic medications, out of the sling, and have full arm control to steer and react safely. Dr. Usama provides individual clearance based on your recovery progress.<\/p><\/div><\/div>\n            <\/div><div class=\"card-wrapper \">\n                <div class=\"card-header\">\n                    <a href=\"#expand-78a45b0\" class=\"card-header-button\" aria-expanded=\"false\" data-target=\"#expand-78a45b0\" aria-controls=\"expand-78a45b0\">\n                        <div class=\"left-icon-group\">\n                <div class=\"normal-icon\"><i aria-hidden=\"true\" class=\"jki jki-plus-light\"><\/i><\/div>\n                <div class=\"active-icon\"><i aria-hidden=\"true\" class=\"jki jki-minus-light\"><\/i><\/div>\n            <\/div><span class=\"title\">What about sleeping after rotator cuff surgery?<\/span>\n                    <\/a>\n                <\/div>\n                <div class=\"card-expand\" id=\"expand-78a45b0\" style=\"display:none\"><div class=\"card-body\"><p>Sleeping after rotator cuff surgery requires a reclined position for 4-6 weeks a recliner is ideal, otherwise use a wedge pillow at 45 degrees. Lying flat increases pressure on the repair and pain. Ice every 2 hours for 20 minutes significantly reduces swelling during early recovery.<\/p><\/div><\/div>\n            <\/div><div class=\"card-wrapper \">\n                <div class=\"card-header\">\n                    <a href=\"#expand-fbb2e14\" class=\"card-header-button\" aria-expanded=\"false\" data-target=\"#expand-fbb2e14\" aria-controls=\"expand-fbb2e14\">\n                        <div class=\"left-icon-group\">\n                <div class=\"normal-icon\"><i aria-hidden=\"true\" class=\"jki jki-plus-light\"><\/i><\/div>\n                <div class=\"active-icon\"><i aria-hidden=\"true\" class=\"jki jki-minus-light\"><\/i><\/div>\n            <\/div><span class=\"title\">Can elderly patients or those over 60 have rotator cuff surgery?<\/span>\n                    <\/a>\n                <\/div>\n                <div class=\"card-expand\" id=\"expand-fbb2e14\" style=\"display:none\"><div class=\"card-body\"><p>Yes. Rotator cuff surgery over 60 and rotator cuff surgery elderly patients achieve excellent outcomes age alone is not a contraindication. Success rates are slightly lower for very large tears in elderly patients due to tissue quality, but pain relief and functional improvement are well-documented across all ages. Dr. Usama evaluates each case individually.<\/p><\/div><\/div>\n            <\/div><\/div>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-e5180a2 e-flex e-con-boxed wpr-particle-no wpr-jarallax-no wpr-parallax-no wpr-sticky-section-no wpr-column-slider-no wpr-equal-height-no e-con e-parent\" data-id=\"e5180a2\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t<div class=\"elementor-element elementor-element-e18659b e-con-full e-flex wpr-particle-no wpr-jarallax-no wpr-parallax-no wpr-sticky-section-no wpr-column-slider-no wpr-equal-height-no e-con e