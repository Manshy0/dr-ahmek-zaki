text-align:center; margin-top:20px;\">\n    <button id=\"loadMoreBtn\" class=\"btn\">Load More<\/button>\n<\/div>\n    <\/section>\n\n   <script>\ndocument.addEventListener('DOMContentLoaded', function () {\n    const typeButtons = document.querySelectorAll('.type-filter');\n    const yearButtons = document.querySelectorAll('.date-filter');\n    const cards = document.querySelectorAll('.event-card');\n    const noEventsMessage = document.querySelector('.no-events-message');\n    const loadMoreBtn = document.getElementById(\"loadMoreBtn\");\n\n    let selectedType = document.querySelector('.type-filter.active')?.dataset.type || '';\n    let selectedYear = 'all';\n    let visibleCount = 9; \/\/ show 9 at a time\n\n    function formatLabel(slug) {\n        return slug.replace(\/-\/g, ' ').replace(\/\\b\\w\/g, char => char.toUpperCase());\n    }\n\n    function updateFilters() {\n        let matchedCards = [];\n\n        cards.forEach(card => {\n            const cardType = card.dataset.type;\n            const cardYear = card.dataset.year;\n\n            const matchesType = selectedType === '' || cardType === selectedType;\n            const matchesYear = selectedYear === 'all' || cardYear === selectedYear;\n\n            if (matchesType && matchesYear) {\n                matchedCards.push(card);\n            } else {\n                card.style.display = 'none';\n            }\n        });\n\n        \/\/ Show only first `visibleCount` of matched cards\n        matchedCards.forEach((card, index) => {\n            card.style.display = index < visibleCount ? 'block' : 'none';\n        });\n\n        \/\/ Show\/hide \"no events\" message\n        if (matchedCards.length === 0) {\n            const typeLabel = selectedType ? formatLabel(selectedType) : 'events';\n            const yearLabel = selectedYear !== 'all' ? ' in ' + selectedYear : '';\n            noEventsMessage.textContent = `No ${typeLabel}${yearLabel} found.`;\n            noEventsMessage.style.display = 'block';\n        } else {\n            noEventsMessage.style.display = 'none';\n        }\n\n        \/\/ Show\/hide Load More\n        loadMoreBtn.style.display = matchedCards.length > visibleCount ? 'inline-block' : 'none';\n    }\n\n    \/\/ Load more handler\n    loadMoreBtn.addEventListener(\"click\", function () {\n        visibleCount += 9;\n        updateFilters();\n    });\n\n    \/\/ Filter handlers\n    typeButtons.forEach(btn => {\n        btn.addEventListener('click', () => {\n            typeButtons.forEach(b => b.classList.remove('active'));\n            btn.classList.add('active');\n            selectedType = btn.dataset.type;\n            visibleCount = 9; \/\/ reset when filter changes\n            updateFilters();\n        });\n    });\n\n    yearButtons.forEach(btn => {\n        btn.addEventListener('click', () => {\n            yearButtons.forEach(b => b.classList.remove('active'));\n            btn.classList.add('active');\n            selectedYear = btn.dataset.year;\n            visibleCount = 9; \/\/ reset when filter changes\n            updateFilters();\n        });\n    });\n\n    updateFilters(); \/\/ Initial run\n});\n<\/script>\n\n\n\n    \n<\/div>\n\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-037b18e e-flex e-con-boxed wpr-particle-no wpr-jarallax-no wpr-parallax-no wpr-sticky-section-no wpr-column-slider-no wpr-equal-height-no e-con e-parent\" data-id=\"037b18e\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-755f861 elementor-invisible elementor-widget elementor-widget-heading\" data-id=\"755f861\" data-element_type=\"widget\" data-e-type=\"widget\" data-settings=\"{&quot;_animation&quot;:&quot;fadeInUp&quot;}\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<h2 class=\"elementor-heading-title 